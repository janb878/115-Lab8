public class BuggyProgram {

    // Method 1: Flattened conditionals with Edge Case Handling
    public static String getGrade(int score) {
        // Validate against impossible scores
        if (score < 0 || score > 100) {
            return "Invalid Score";
        }

        // Inclusive boundary checks
        if (score >= 90) {
            return "Exceeds";
        } else if (score >= 80) {
            return "Meets";
        } else {
            return "Does Not Meet";
        }
    }
}
    // Method 2: loop with array
    public static int sumEvenNumbers(int[] values) {
        int sum = 0;

        for (int value : values) {
            if (value % 2 == 0) {
                sum += value;
            }
        }

        return sum;
    }
}
     // Method 3: loop with bounds (no array)
      public static int sumRange(int start, int end) {
          int sum = 0;

          for (int i = start; i <= end; i++) {
              sum += i;
          }

           return sum;
       }

       public static void main(String[] args ){
           System.out.println("Test the program using the JUnit tests");
       }

   }